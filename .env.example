# scripts/dev_env.py generates private local credentials; do not copy these placeholders to production.
APP_ENV=development
POSTGRES_PASSWORD=GENERATE_LOCALLY
AUTH_DB_PASSWORD=GENERATE_LOCALLY
DATABASE_URL=postgresql+asyncpg://civis:GENERATE_LOCALLY@localhost:55432/civis
AUTH_DATABASE_URL=postgresql://auth:GENERATE_LOCALLY@auth-db:5432/auth
REDIS_URL=redis://localhost:56379/0
SUPERTOKENS_URI=http://localhost:53567
SUPERTOKENS_API_KEY=GENERATE_LOCALLY
API_DOMAIN=http://localhost:58000
WEB_DOMAIN=http://localhost:53000
S3_ENDPOINT=http://localhost:59000
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=GENERATE_LOCALLY
S3_SECRET_KEY=GENERATE_LOCALLY
S3_BUCKET=civis-private
DOCUMENT_ENCRYPTION_KEY=GENERATE_BASE64_32_BYTES
LOG_HMAC_KEY=GENERATE_LOCALLY
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_FROM=civis@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
ALLOW_UNAPPROVED_TEMPLATES=false
LOAD_FAKE_SEED=true
FAKE_LEGAL_TEXT=false
REQUIRE_EMAIL_VERIFICATION=false
FREE_PROMPTS=20
FEATURE_UPLOADS=false
LLM_PROVIDER=groq
FAKE_MODEL=false
FAKE_STREAM_DELAY=0.01
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_HISTORY_MAX_CHARS=24000
DRAFTING_CONFIDENCE_THRESHOLD=0.6
OWNER_TEMPLATES_FILE=content/owner-supplied/templates.json
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MAX_OUTPUT_TOKENS=2048
LEGAL_CONTENT_FILE=
# Optional telemetry destinations; use your own credentials.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Hosted Uganda Research retrieval; key stays server-side.
RETRIEVAL_PROVIDER=disabled
LAWS_AFRICA_API_KEY=
LAWS_AFRICA_BASE_URL=https://api.laws.africa/ai/v1
RETRIEVAL_TOP_K=3
RETRIEVAL_MAX_CHARS=12000
