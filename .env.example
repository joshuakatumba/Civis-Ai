# scripts/dev_env.py generates private local credentials; do not copy these placeholders to production.
APP_ENV=development
POSTGRES_PASSWORD=GENERATE_LOCALLY
AUTH_DB_PASSWORD=GENERATE_LOCALLY
DATABASE_URL=postgresql+asyncpg://civis:GENERATE_LOCALLY@localhost:55432/civis
AUTH_DATABASE_URL=postgresql://auth:GENERATE_LOCALLY@auth-db:5432/auth
REDIS_URL=redis://localhost:56379/0
SUPERTOKENS_URI=http://localhost:53567
SUPERTOKENS_API_KEY=GENERATE_LOCALLY
API_DOMAIN=http://localhost:58000
WEB_DOMAIN=http://localhost:53000
S3_ENDPOINT=http://localhost:59000
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=GENERATE_LOCALLY
S3_SECRET_KEY=GENERATE_LOCALLY
S3_BUCKET=civis-private
DOCUMENT_ENCRYPTION_KEY=GENERATE_BASE64_32_BYTES
LOG_HMAC_KEY=GENERATE_LOCALLY
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_FROM=civis@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
ALLOW_UNAPPROVED_TEMPLATES=true
LOAD_FAKE_SEED=true
